# BotHost / Telegram bot. Set these in hosting secrets, never commit real values.
BOT_TOKEN=
MINI_APP_URL=
# Может содержать несколько адресов через запятую: https://g-partner.store,https://g-partner.ru
PUBLIC_ORIGIN=
# Optional ownership tokens from search-engine webmaster consoles.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
ADMIN_USERNAME=megaolegshop2000
# Generate with python scripts/admin_password.py; use HASH or PASSWORD, not both.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
DATA_DIR=/app/data
COOKIE_SECURE=true
PORT=8000
# Explicit website-only mode for local development or separate hosting.
WEB_ONLY=false
# Server-only OAuth token with read access to Yandex Metrika counter 112522333.
# Never put this value in VITE_* variables, public settings, or GitHub.
YANDEX_METRIKA_TOKEN=

# T-Bank Internet Acquiring (server-side secrets).
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Fill these two only when the online cash register is enabled for the terminal.
TBANK_TAXATION=
TBANK_ITEM_TAX=none
# T-Bank installment and credit. Shop and showcase ids are built in; override only
# when the bank issues new ones. The secret protects the installment webhook URL.
TBANK_SHOP_ID=
TBANK_SHOWCASE_ID=
TBANK_CREDIT_WEBHOOK_SECRET=
# Optional bank promo codes for the installment and credit programmes.
TBANK_INSTALLMENT_PROMO=
TBANK_CREDIT_PROMO=
# Public CDEK widget key: the pickup-point map then opens inside the cart.
# It can also be pasted in the CRM instead of this variable.
CDEK_WIDGET_API_KEY=
# Customer email notifications.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Optional HTTPS endpoint of your SMS provider; receives {"to": "+7...", "text": "..."}.
SMS_WEBHOOK_URL=
